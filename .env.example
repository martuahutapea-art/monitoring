PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=ganti-dengan-random-secret-acak-minimal-32-karakter

# Opsional untuk akun demo lokal saja. Jangan aktifkan pada deployment publik.
SEED_DEMO=false
DEMO_ADMIN_PASSWORD=ganti-password-admin
DEMO_STUDENT_PASSWORD=ganti-password-siswa
DEMO_TEACHER_PASSWORD=ganti-password-guru
DEMO_INDUSTRY_PASSWORD=ganti-password-industri

# Koordinat di bawah hanya contoh; ganti dengan lokasi perusahaan sebenarnya.
COMPANY_LAT=-0.9471
COMPANY_LON=100.4172
GEOFENCE_RADIUS_METERS=1000

# Pengaturan satu kali untuk membuat admin pertama pada database kosong.
# Isi di dashboard hosting, deploy, lalu hapus BOOTSTRAP_ADMIN_PASSWORD setelah admin dibuat.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=buat-password-acak-minimal-14-karakter
BOOTSTRAP_ADMIN_NAME=Administrator SIMON
